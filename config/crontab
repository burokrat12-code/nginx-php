# 1. Динамическое обновление собственных DDNS IP (каждые 5 минут)
*/5 * * * * root /usr/local/bin/update_my_ips.sh >/dev/null 2>&1
# 2. Обновление диапазонов Cloudflare IP (каждый день в 3:00)
0 3 * * * root /usr/local/bin/update-cloudflare-ips.sh reload > /var/log/cloudflare-update.log 2>&1
# 3. Обновление диапазонов Google IP (каждый день в 3:05)
5 3 * * * root /usr/local/bin/update_google_ips.sh >/dev/null 2>&1
