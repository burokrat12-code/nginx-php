http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    
    # =============================
    # RATE LIMITS
    # =============================
    limit_req_zone $binary_remote_addr zone=main_limit:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=push_limit:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=mail_limit:10m rate=3r/s;
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=2r/s;

    limit_conn_zone $binary_remote_addr zone=main_conn:10m;
    limit_conn_zone $binary_remote_addr zone=push_conn:10m;
    limit_conn_zone $binary_remote_addr zone=mail_conn:10m;

    limit_req_status 429;
    limit_conn_status 429;
    
    # =============================
    # MAPS
    # =============================
    map $http_user_agent $is_bad_ua {
        default 0;
        ~*(nmap|nikto|sqlmap|acunetix|nessus|masscan|zgrab|netsparker|qualys|whatweb) 1;
        "~^Mozilla/5\.0$" 1;
    }

    map $uri $is_long_uri {
        default 0;
        "~^/.{120,}" 1;
    }
    
    
    # Разрешаем только GET, POST, HEAD (TRACE/CONNECT/PUT/DELETE/OPTIONS - 444)
    map $request_method $is_allowed_method {
        default 0;
        GET     1;
        POST    1;
        HEAD    1;
    
    }

    #map "$request_method:$host" $is_allowed_method {
    #    default 0;

    #    # 1. Базовые методы разрешены ДЛЯ ВСЕХ сайтов
    #    ~^GET: 1;
    #    ~^POST: 1;
    #    ~^HEAD: 1;

    #    # 2. REST API методы (PUT/DELETE/PATCH/OPTIONS) разрешены ТОЛЬКО для Home Assistant
    #    OPTIONS:homeassru.cargo-port.eu 1;
    #    PUT:homeassru.cargo-port.eu     1;
    #    DELETE:homeassru.cargo-port.eu  1;
    #    PATCH:homeassru.cargo-port.eu   1;
    #}

    sendfile on;
    keepalive_timeout 65;
    server_tokens off;

    # =============================
    # GZIP СЖАТИЕ
    # =============================
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1000;
    gzip_disable "msie6";
    
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        text/x-js
        text/js
        application/json
        application/javascript
        application/x-javascript
        application/xml
        application/rss+xml
        application/atom+xml
        application/ld+json
        application/manifest+json
        image/svg+xml
        font/ttf
        font/otf
        font/x-woff
        font/woff
        font/woff2
        image/x-icon
        image/vnd.microsoft.icon;

    # Глобальная настройка Real IP (Cloudflare + HAProxy)
    include /etc/nginx/cloudflare_real_ips.conf;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ${HAPROXY_IP};
    set_real_ip_from ${VLESS_BACKEND};
    
    real_ip_recursive on;

    # Проверка IP-адреса Google Assistant (благодаря real_ip $remote_addr уже содержит IP конечного клиента)
    geo $remote_addr $is_google {
        default 0;
        include /etc/nginx/google_ips.conf;
    }

    geo $remote_addr $is_my_ip {
        default 0;
        include /etc/nginx/my_custom_ips.conf;
    }

    # Ограничение размера заголовков
    large_client_header_buffers 4 8k;

    log_format main '$proxy_protocol_addr - $remote_user [$time_local] "$request" '
                '$status $body_bytes_sent "$http_referer" '
                '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    # Глобальные заголовки безопасности
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "upgrade-insecure-requests";

    # ========== CADDY ==========
    server {
        listen 8444 ssl;

        server_name caddy.cargo-port.eu;
        set_real_ip_from 192.168.254.42;  # IP Caddy
        real_ip_header X-Forwarded-For;
        real_ip_recursive on;

        ssl_certificate /etc/ssl/certs/${MAIN_DOMAIN}.crt;
        ssl_certificate_key /etc/ssl/certs/${MAIN_DOMAIN}.key;

        ssl_protocols TLSv1.2 TLSv1.3;

        root ${WEB_ROOT};
        index index.html;

        # без proxy_protocol !!!
        # без real_ip_header proxy_protocol !!!

        location / {
            try_files $uri $uri/ =404;
        }
    }


    # ========== ОСНОВНОЙ СЕРВЕР ==========
    server {
        listen 8443 ssl proxy_protocol;
        server_name ${MAIN_DOMAIN};

        set_real_ip_from 127.0.0.1;
        set_real_ip_from ${HAPROXY_IP};
        set_real_ip_from ${VLESS_BACKEND};
        real_ip_header proxy_protocol;

        limit_req zone=main_limit burst=20 nodelay;
        limit_conn main_conn 20;

        ssl_certificate /etc/ssl/certs/${MAIN_DOMAIN}.crt;
        ssl_certificate_key /etc/ssl/certs/${MAIN_DOMAIN}.key;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        root ${WEB_ROOT};
        index index.html index.php;

        error_page 403 /403.html;
        error_page 404 /404.html;

        if ($is_allowed_method = 0) { return 444; }
        if ($is_long_uri) { return 444; }
        if ($is_bad_ua) { return 444; }

        # РАЗРЕШАЕМ ИКОНКИ
        location ~* ^/favicon.*\.(png|ico|jpg|jpeg|svg)$ {
            access_log off;
            log_not_found off;
            allow all;
            expires 30d;
        }

        # ЗАЩИТА И БЕЗОПАСНОСТЬ
        location ~ /\. { deny all; return 444; }
        location ~* (wp-admin|wp-login|xmlrpc|wp-config|setup-config|\.env|\.git|\.svn|\.htaccess|\.htpasswd|phpmyadmin|adminer|webdav|autodiscover|geoserver) { return 444; }
        location ~* /(info|test|phpinfo|debug|dev|config|setup|install|probe|check|status)\.php$ { deny all; return 444; }
        location ~* \.(txt|log|ini|conf|bak|backup|old|sql|zip|tar|gz|sqlite|db|yml|yaml|json|xml|sh|py|pl|rb)$ { deny all; return 403; }

        location / {
            try_files $uri $uri/ =404;
        }

                # ========== PHP ОБРАБОТКА ==========
        
        # Разрешённые PHP endpoints (точные совпадения)
        location = /login.php {
            limit_except POST {
                deny all;
            }

            limit_req zone=auth_limit burst=5 nodelay;
            include fastcgi_params;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param REMOTE_ADDR $remote_addr;
            fastcgi_param HTTP_X_REAL_IP $remote_addr;
            fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
            fastcgi_param HTTP_CF_CONNECTING_IP $http_cf_connecting_ip;
        }

        location = /get-ip.php {
            include fastcgi_params;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param REMOTE_ADDR $remote_addr;
            fastcgi_param HTTP_X_REAL_IP $remote_addr;
            fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
            fastcgi_param HTTP_CF_CONNECTING_IP $http_cf_connecting_ip;
        }

        # ЧПУ (pretty URLs) → редирект на PHP
        location = /login {
            rewrite ^ /login.php last;
        }

        location = /get-ip {
            rewrite ^ /get-ip.php last;
        }

        # Запрет всех остальных .php файлов
        location ~ \.php$ {
            return 444;
        }

        # СТРАНИЦЫ ОШИБОК И РЕСУРСЫ
        location = /403.html { root /var/www/html/403; internal; }
        location = /404.html { root /var/www/html/404; internal; }
        location = /bg-video.mp4 { root /var/www/html/404; default_type video/mp4; add_header Accept-Ranges bytes; }
        location = /bg-poster.jpeg { root /var/www/html/404; default_type image/jpeg; }
        location = /bg-video_403.mp4 { root /var/www/html/403; default_type video/mp4; add_header Accept-Ranges bytes; }
        location = /bg-poster_403.jpeg { root /var/www/html/403; default_type image/jpeg; }
        location /403/ { root /var/www/html; }
        location /404/ { root /var/www/html; }
    }

    # ========== PUSH СЕРВЕР (ФИЛЬТРАЦИЯ ПО IP + USER-AGENT) ==========
    server {
        listen 8443 ssl proxy_protocol;
        server_name ${PUSH_DOMAIN};

        set_real_ip_from 127.0.0.1;
        set_real_ip_from ${HAPROXY_IP};
        set_real_ip_from ${VLESS_BACKEND};
        real_ip_header proxy_protocol;

        limit_req zone=push_limit burst=50 nodelay;
        limit_conn push_conn 50;

        ssl_certificate /etc/ssl/certs/${MAIN_DOMAIN}.crt;
        ssl_certificate_key /etc/ssl/certs/${MAIN_DOMAIN}.key;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        error_page 403 /403.html;
        error_page 404 /404.html;

        # ГЛОБАЛЬНЫЕ ПРОВЕРКИ
        if ($is_allowed_method = 0) { return 444; }
        if ($is_bad_ua) { return 444; }
        if ($is_long_uri) { return 444; }

        # ЗАЩИТА ОТ ОПАСНЫХ ПУТЕЙ
        location ~ /\. { deny all; return 404; }
        location ~* (wp-admin|wp-login|xmlrpc|wp-config|setup-config|\.env|\.git|\.svn|\.htaccess|\.htpasswd|phpmyadmin|adminer|webdav|autodiscover|geoserver) { return 404; }
        location ~* /(info|test|phpinfo|debug|dev|config|setup|install|probe|check|status)\.php$ { deny all; return 404; }
        location ~* \.(txt|log|ini|conf|bak|backup|old|sql|zip|tar|gz|sqlite|db|yml|yaml|sh|py|pl|rb)$ { deny all; return 404; }

        # СТРАНИЦЫ ОШИБОК
        location = /403.html { root /var/www/html/403; internal; }
        location = /404.html { root /var/www/html/404; internal; }
        location = /bg-video.mp4 { root /var/www/html/404; default_type video/mp4; add_header Accept-Ranges bytes; }
        location = /bg-poster.jpeg { root /var/www/html/404; default_type image/jpeg; }
        location = /bg-video_403.mp4 { root /var/www/html/403; default_type video/mp4; add_header Accept-Ranges bytes; }
        location = /bg-poster_403.jpeg { root /var/www/html/403; default_type image/jpeg; }
        location /403/ { root /var/www/html; }
        location /404/ { root /var/www/html; }

        # ЗАГОЛОВКИ БЕЗОПАСНОСТИ
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "upgrade-insecure-requests";
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;

        # ОСНОВНОЙ ЛОКЕЙШН
        location / {
            # Разрешаем доступ если совпал $is_my_ip ИЛИ User-Agent
            set $access_allowed 0;

            if ($is_my_ip = 1) {
                set $access_allowed 1;
            }

            if ($http_user_agent ~* "${NTFY_UserAgent}") {
                set $access_allowed 1;
            }

            # 2. Проверяем СЕКРЕТНЫЙ ЗАГОЛОВОК (для приложения и MikroTik)
            # Nginx автоматически переводит заголовок X-Secret-Token в переменную $http_x_secret_token
            if ($http_x_secret_token = $X_TOKEN) {
                set $access_allowed 1;
            }

            if ($access_allowed = 0) {
                return 444;
            }

            # Проксирование на ntfy
            proxy_pass http://${NTFY_BACKEND}:80;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;

            # Отключение буферизации для SSE / JSON Stream
            proxy_buffering off;
            proxy_cache off;
            chunked_transfer_encoding off;

            # Динамический Upgrade / Connection для WebSocket
            proxy_set_header Upgrade $http_upgrade;
            set $conn_directive "upgrade";
            if ($http_upgrade = "") {
                set $conn_directive "";
            }
            proxy_set_header Connection $conn_directive;

            # Таймауты для удерживания сокетов
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }
    }

    # ========== MAIL СЕРВЕР (RESTRICTED TO MY IPs ONLY) ==========
    server {
        listen 8443 ssl proxy_protocol;
        server_name ${MAIL_DOMAIN};

        set_real_ip_from 127.0.0.1;
        set_real_ip_from ${HAPROXY_IP};
        set_real_ip_from ${VLESS_BACKEND};
        real_ip_header proxy_protocol;

        limit_req zone=mail_limit burst=5 nodelay;
        limit_conn mail_conn 10;

        ssl_certificate /etc/ssl/certs/${MAIN_DOMAIN}.crt;
        ssl_certificate_key /etc/ssl/certs/${MAIN_DOMAIN}.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        error_page 403 /403.html;
        error_page 404 /404.html;

        # 🛑 1. ЖЕСТКАЯ ПРОВЕРКА IP: Доступ разрешен ТОЛЬКО с твоих IP
        if ($is_my_ip = 0) {
            return 444;
        }

        # Базовые проверки на ботов и мусор
        if ($is_allowed_method = 0) { return 444; }
        if ($is_bad_ua) { return 444; }
        if ($is_long_uri) { return 444; }

        # ЗАЩИТА ОТ ОПАСНЫХ ПУТЕЙ И СКРИПТОВ
        location ~ /\. { deny all; return 444; }
        location ~* (wp-admin|wp-login|xmlrpc|wp-config|setup-config|\.env|\.git|\.svn|\.htaccess|\.htpasswd|phpmyadmin|adminer|webdav|autodiscover|geoserver) { return 444; }
        location ~* /(info|test|phpinfo|debug|dev|config|setup|install|probe|check|status)\.php$ { deny all; return 444; }
        location ~* \.(txt|log|ini|conf|bak|backup|old|sql|zip|tar|gz|sqlite|db|yml|yaml|json|xml|sh|py|pl|rb)$ { deny all; return 403; }

        # СТРАНИЦЫ ОШИБОК
        location = /403.html { root /var/www/html/403; internal; }
        location = /404.html { root /var/www/html/404; internal; }
        location = /bg-video.mp4 { root /var/www/html/404; default_type video/mp4; add_header Accept-Ranges bytes; }
        location = /bg-poster.jpeg { root /var/www/html/404; default_type image/jpeg; }
        location = /bg-video_403.mp4 { root /var/www/html/403; default_type video/mp4; add_header Accept-Ranges bytes; }
        location = /bg-poster_403.jpeg { root /var/www/html/403; default_type image/jpeg; }
        location /403/ { root /var/www/html; }
        location /404/ { root /var/www/html; }

        # ЗАГОЛОВКИ БЕЗОПАСНОСТИ
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "upgrade-insecure-requests";
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;

        # 🟢 2. ПОЛНЫЙ ДОСТУП К ВЕБ-ПОЧТЕ (Проксирование всех запросов)
        location / {
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-XSS-Protection "1; mode=block" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;

            proxy_pass https://${MAIL_BACKEND}:443;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            proxy_buffering off;
            proxy_ssl_verify off;
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
        }
    }

    # ========== HOME ASSISTANT (RESTRICTED: GOOGLE INTEGRATION + MY FULL ACCESS) ==========
    server {
        listen 8443 ssl proxy_protocol;
        server_name ${HA_DOMAIN};

        #access_log /var/log/nginx/homeass_access.log;
        #error_log  /var/log/nginx/homeass_error.log warn;

        set_real_ip_from 127.0.0.1;
        set_real_ip_from ${HAPROXY_IP};
        set_real_ip_from ${VLESS_BACKEND};
        real_ip_header proxy_protocol;

        limit_req zone=main_limit burst=80 nodelay;
        limit_conn main_conn 50;

        ssl_certificate /etc/ssl/certs/${MAIN_DOMAIN}.crt;
        ssl_certificate_key /etc/ssl/certs/${MAIN_DOMAIN}.key;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # 🛑 1. ПРОВЕРКА IP: Допускаются ТОЛЬКО Google и твой IP
        set $access_allowed 0;
        if ($is_google = 1) { set $access_allowed 1; }
        if ($is_my_ip = 1) { set $access_allowed 1; }

        if ($access_allowed = 0) {
            return 444;
        }

        # Базовые проверки на ботов и мусор
        if ($is_allowed_method = 0) { return 444; }
        if ($is_bad_ua) { return 444; }
        if ($is_long_uri) { return 444; }

        # 🟢 2. ЭНДПОИНТЫ GOOGLE ASSISTANT И АВТОРИЗАЦИИ (Доступны и для Google, и для тебя)
        location ~* ^/(auth/authorize|auth/token|api/google_assistant|static/|frontend_latest/|manifest\.json|auth/providers) {
            proxy_pass http://${HA_BACKEND}:28443;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            proxy_buffering off;
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
        }

        # 🟢 3. ПОЛНЫЙ ИНТЕРФЕЙС HA (Доступен ТОЛЬКО с твоего IP, Google отсюда отбрасывается)
        location / {
            if ($is_my_ip = 0) {
                return 444;
            }

            proxy_pass http://${HA_BACKEND}:28443;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;

            # Полная поддержка WebSocket для работы интерфейса Home Assistant
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            proxy_buffering off;
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
        }
    }

    # HTTP → HTTPS редирект
    server {
        listen 80;
        server_name ${MAIN_DOMAIN} ${PUSH_DOMAIN} ${MAIL_DOMAIN} ${HA_DOMAIN};
        
        access_log /var/log/nginx/access_http.log main;

        location ~* (wp-admin|wp-login|xmlrpc|wp-config|setup-config|\.env|\.git|\.svn) {
            return 444;
        }

        location / {
            return 301 https://$host$request_uri;   # исправлено: $server_name → $host
        }
    }
}
